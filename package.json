{
  "version": "4.0.0",
  "name": "mudita-center",
  "description": "Mudita Center",
  "private": true,
  "scripts": {
    "setup": "npm ci",
    "postsetup": "nx setup app && nx fonts:download app && nx news:download app && nx help:download app",
    "postinstall": "patch-package && npm run generate:licenses",
    "==== Development ==============": "",
    "start": "nx serve app",
    "start:watch": "nx serve app --watch",
    "preview": "nx preview app",
    "==== Building electron app =====": "",
    "build:mac": "nx build:mac app",
    "build:linux": "nx build:linux app",
    "build:win": "nx build:win app",
    "==== Code quality =============": "",
    "lint": "nx run-many --targets=lint,stylelint,typecheck",
    "test": "nx run-many --target=test --exclude api-devices-testing",
    "test:e2e": "nx start app-e2e",
    "==== Storybook ================": "",
    "storybook": "nx storybook web",
    "storybook:build": "nx build-storybook web",
    "==== Nx utils =================": "",
    "nx:update": "npx nx migrate latest",
    "nx:migrate": "npx nx migrate --run-migrations",
    "nx:reset": "nx reset",
    "lib:create": "ts-node ./scripts/create-library.ts",
    "==== Project tools =================": "",
    "audit:icons": "tsx scripts/audit-icons.ts ./libs/app-theme/ui/src/lib/icon/svg",
    "generate:licenses": "ts-node ./scripts/license-generator.ts",
    "api-device-testing": "npx nx run api-devices-testing:test --skip-nx-cache -- --verbose --coverage=false --testPathIgnorePatterns=serial-port-performance.spec.ts",
    "api-device-testing:speed": "npx nx run api-devices-testing:test --skip-nx-cache -- --verbose --coverage=false --testPathPatterns=serial-port-performance.spec.ts"
  },
